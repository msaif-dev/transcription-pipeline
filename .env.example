# Copy to .env and adjust. Every setting in app/config.py can be overridden with STT_<NAME>.
STT_ENGINE=faster-whisper          # or "mock" (no model download; for dev/tests)
STT_MODEL_SIZE=base                # tiny | base | small | medium | large-v3 | distil-large-v3
STT_DEVICE=cpu                     # cpu | cuda | auto
STT_COMPUTE_TYPE=int8              # int8 on CPU; float16 on GPU
STT_VAD_FILTER=true
STT_WORD_TIMESTAMPS=false
STT_PRELOAD_MODEL=false

STT_CHUNK_SECONDS=600              # long files are split into ~10 min chunks...
STT_CHUNK_SEARCH_SECONDS=15        # ...cut at the quietest point within +/-15 s of the target

STT_MAX_UPLOAD_MB=500
STT_MAX_DURATION_SECONDS=14400     # 4 h
STT_SYNC_MAX_DURATION_SECONDS=60   # longer uploads become background jobs (HTTP 202)
STT_JOB_WORKERS=1
STT_UPLOAD_DIR=data/uploads
